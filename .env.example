# Staff HQ (gieok-web). Copy to the dotenv file beside this one and fill in. Never commit the real one.
# The tailnet address of this host (tailscale ip -4). The site refuses any other address.
GIEOK_WEB_HOST=
GIEOK_WEB_PORT=8740
# Only if Discord should redirect somewhere other than http://GIEOK_WEB_HOST:GIEOK_WEB_PORT
GIEOK_WEB_URL=
# Daepyo's Discord application (Developer Portal > OAuth2). Redirect: <site>/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GUILD_ID=
# Members holding one of these roles get read-only access. The guild owner can edit.
ALLOWED_ROLE_IDS=
# Optional. A Discord webhook for scheduled reports.
REPORTS_WEBHOOK_URL=
# Optional overrides
GIEOK_ROOT=~/.local/share/gieok
STAFF_DB=~/.local/state/staff/staff.db
STAFF_AGENTS=daepyo:claude:~/oscar/state:oscar.service,saekdong:codex:~/saekdong/state:saekdong.service
GITHUB_OWNER=oddballmeasure
